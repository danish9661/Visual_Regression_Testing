{
  "baseUrl": "http://127.0.0.1:4567",//this is the address of the website which we have to visit to test. Points at the bundled demo site (npm run demo:serve); change it to your own app //
  "routes": [
    "/"
  ],//here we add addition pages or pages in the site which we have to test. Eg- home,about
  "viewports": [// viewport contains the screen sizes to simulate
    {
      "name": "desktop",
      "width": 1440,
      "height": 900
    },
    {
      "name": "mobile",
      "width": 375,
      "height": 812
    }
  ],
  "maskSelectors": [// elements of css to disable before taking the ss
    ".timestamp",
    ".dynamic-ad",
    "img.avatar"
  ],
  "threshold": 0.01, // filter that how much error is acceptable and after what % is it a faliure
  // Settings for `visual-ci compare-branches` (PR/MR: render base and head, then diff them).
  "branchCompare": {
    "baseRef": "origin/main",
    "baseStrategy": "merge-base",
    "installCommand": "", // node_modules are already installed by CI; empty means reuse them
    "startCommand": "npm run demo:serve",
    "waitOnPath": "/",
    "portBase": 4100,
    "portHead": 4101,
    "startTimeoutMs": 60000,
    "routeSources": { "/": ["scripts/demo-app.js"] },
    "onRegression": "fail",
    "report": { "comment": true, "maxRows": 25 }
  }
}
